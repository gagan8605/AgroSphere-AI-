# ==============================================================================
# AgroSphere AI - Environment Configuration
# ==============================================================================

# Free Groq API Key (Sign up at https://console.groq.com/keys)
GROQ_API_KEY=

# Groq Model Selection (default: llama-3.1-8b-instant or gemma2-9b-it)
GROQ_MODEL=llama-3.1-8b-instant

# Weather API (Optional - Default uses built-in realistic regional weather engine)
OPENWEATHER_API_KEY=

# Project & Facility Defaults
COMPANY_NAME=AgroSphere AI
MANUFACTURING_HUB=AgroSphere Central Logistics & Manufacturing Hub
DEFAULT_SURGE_THRESHOLD_PCT=25.0
ALERT_SIMULATION_MODE=True
